local Fluent = {}
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local PlayerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

Fluent.Theme = {
    Background = Color3.fromRGB(15, 15, 17),
    Element    = Color3.fromRGB(28, 28, 31),
    ElementHover = Color3.fromRGB(38, 38, 42),
    Accent     = Color3.fromRGB(23, 252, 3),
    Text       = Color3.fromRGB(240, 240, 240),
    SubText    = Color3.fromRGB(150, 150, 150),
}

local function create(inst, props)
    local obj = Instance.new(inst)
    for k, v in pairs(props) do obj[k] = v end
    return obj
end

function Fluent:CreateWindow(title)
    local Window = {}
    local gui = create("ScreenGui", {Name = "FluentUI", ResetOnSpawn = false, Parent = PlayerGui})
    local main = create("Frame", {
        Size = UDim2.new(0, 750, 0, 500), Position = UDim2.new(0.5, -375, 0.5, -250),
        BackgroundColor3 = self.Theme.Background, BorderSizePixel = 0, Active = true, Parent = gui
    })
    create("UICorner", {CornerRadius = UDim.new(0, 10), Parent = main})
    create("UIStroke", {Color = Color3.fromRGB(40, 40, 45), Thickness = 1, Parent = main})

    -- Kéo thả
    local dragging, dragInput, dragStart, startPos
    local titleBar = create("Frame", {Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = main})
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Tiêu đề & Close
    create("TextLabel", {Size = UDim2.new(1, -40, 1, 0), Position = UDim2.new(0, 20, 0, 0), BackgroundTransparency = 1, Text = title, RichText = true, TextColor3 = self.Theme.Text, Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, Parent = titleBar})
    local closeBtn = create("TextButton", {Size = UDim2.new(0, 40, 1, 0), Position = UDim2.new(1, -45, 0, 0), BackgroundTransparency = 1, Text = "×", TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.Gotham, TextSize = 40, Parent = titleBar})
    closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

    -- Body & Sidebar
    local body = create("Frame", {Size = UDim2.new(1, 0, 1, -40), Position = UDim2.new(0, 0, 0, 40), BackgroundTransparency = 1, Parent = main})
    local sidebar = create("Frame", {Size = UDim2.new(0, 180, 1, -20), Position = UDim2.new(0, 15, 0, 10), BackgroundTransparency = 1, Parent = body})
    local tabContainer = create("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Parent = sidebar})
    create("UIListLayout", {Padding = UDim.new(0, 8), Parent = tabContainer})
    
    local slidingLine = create("Frame", {Size = UDim2.new(0, 4, 0, 16), BackgroundColor3 = self.Theme.Accent, ZIndex = 2, Parent = sidebar})
    create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = slidingLine})

    local contentHolder = create("Frame", {Size = UDim2.new(1, -210, 1, -20), Position = UDim2.new(0, 195, 0, 10), BackgroundTransparency = 1, Parent = body})
    local tabButtons = {}
    local currentGroup = nil

    local function switchTab(newGroup, btn)
        TweenService:Create(slidingLine, TweenInfo.new(0.2), {Position = UDim2.new(0, 0, 0, btn.AbsolutePosition.Y - sidebar.AbsolutePosition.Y + (btn.AbsoluteSize.Y / 2) - 8)}):Play()
        if currentGroup == newGroup then return end
        if currentGroup then
            TweenService:Create(currentGroup, TweenInfo.new(0.2), {GroupTransparency = 1, Position = UDim2.new(0, 0, 0, 10)}):Play()
            task.delay(0.2, function() currentGroup.Visible = false end)
        end
        newGroup.Visible = true
        newGroup.Position = UDim2.new(0, 0, 0, 10)
        newGroup.GroupTransparency = 1
        TweenService:Create(newGroup, TweenInfo.new(0.25), {GroupTransparency = 0, Position = UDim2.new(0, 0, 0, 0)}):Play()
        currentGroup = newGroup
    end

    function Window:AddTab(name, iconId)
        local group = create("CanvasGroup", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, GroupTransparency = 1, Visible = false, Parent = contentHolder})
        local page = create("ScrollingFrame", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = Color3.fromRGB(50, 50, 55), CanvasSize = UDim2.new(0, 0, 0, 0), Parent = group})
        local layout = create("UIListLayout", {Padding = UDim.new(0, 8), Parent = page})
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y) end)

        local wrapper = create("Frame", {Size = UDim2.new(1, -40, 0, 32), BackgroundTransparency = 1, Parent = tabContainer})
        local btn = create("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = self.Theme.Element, Text = name, TextColor3 = self.Theme.SubText, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, Parent = wrapper})
        create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = btn})
        create("UIPadding", {PaddingLeft = UDim.new(0, 35), Parent = btn})
        create("ImageLabel", {Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(0, 12, 0.5, -7), BackgroundTransparency = 1, ImageColor3 = self.Theme.SubText, Image = iconId or "rbxassetid://6031075931", ZIndex = 2, Parent = wrapper})

        btn.MouseButton1Click:Connect(function()
            for _, o in ipairs(tabButtons) do
                o.BackgroundColor3 = self.Theme.Element; o.TextColor3 = self.Theme.SubText; o.Font = Enum.Font.Gotham
            end
            btn.BackgroundColor3 = self.Theme.ElementHover; btn.TextColor3 = self.Theme.Text; btn.Font = Enum.Font.GothamBold
            switchTab(group, btn)
        end)
        table.insert(tabButtons, btn)

        local Tab = {}
        function Tab:AddSection(titleText)
            local section = create("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = page})
            create("UIListLayout", {Padding = UDim.new(0, 8), Parent = section})
            if titleText and titleText ~= "" then
                create("TextLabel", {Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = titleText, TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.GothamBold, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = -1, Parent = section})
            end
            local inner = create("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = section})
            create("UIListLayout", {Padding = UDim.new(0, 8), Parent = inner})
            
            local Section = {}
            function Section:AddButton(text, callback)
                local exBtn = create("TextButton", {Size = UDim2.new(1, 0, 0, 37), BackgroundColor3 = self.Theme.Element, Text = "", AutoButtonColor = false, Parent = inner})
                create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = exBtn})
                create("TextLabel", {Size = UDim2.new(1, -40, 1, 0), Position = UDim2.new(0, 12, 0, 0), BackgroundTransparency = 1, Text = text, TextColor3 = self.Theme.Text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = exBtn})
                
                exBtn.MouseEnter:Connect(function() TweenService:Create(exBtn, TweenInfo.new(0.15), {BackgroundColor3 = self.Theme.ElementHover}):Play() end)
                exBtn.MouseLeave:Connect(function() TweenService:Create(exBtn, TweenInfo.new(0.15), {BackgroundColor3 = self.Theme.Element}):Play() end)
                exBtn.MouseButton1Click:Connect(callback)
            end

            function Section:AddToggle(text, default, callback)
                local toggleHolder = create("TextButton", {Size = UDim2.new(1, 0, 0, 37), BackgroundColor3 = self.Theme.Element, Text = "", AutoButtonColor = false, Parent = inner})
                create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = toggleHolder})
                create("TextLabel", {Size = UDim2.new(1, -60, 1, 0), Position = UDim2.new(0, 12, 0, 0), BackgroundTransparency = 1, Text = text, TextColor3 = self.Theme.Text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = toggleHolder})
                
                local track = create("Frame", {Size = UDim2.new(0, 30, 0, 16), Position = UDim2.new(1, -42, 0.5, -8), BackgroundColor3 = Color3.fromRGB(40, 40, 45), Parent = toggleHolder})
                create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = track})
                local dot = create("Frame", {Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(0, 2, 0.5, -6), BackgroundColor3 = self.Theme.SubText, Parent = track})
                create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = dot})

                local state = default or false
                toggleHolder.MouseButton1Click:Connect(function()
                    state = not state
                    TweenService:Create(track, TweenInfo.new(0.2), {BackgroundColor3 = state and self.Theme.Accent or Color3.fromRGB(40, 40, 45)}):Play()
                    TweenService:Create(dot, TweenInfo.new(0.2), {Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)}):Play()
                    if callback then callback(state) end
                end)
            end

            return Section
        end

        if #tabButtons == 1 then
            btn.BackgroundColor3 = self.Theme.ElementHover; btn.TextColor3 = self.Theme.Text; btn.Font = Enum.Font.GothamBold
            switchTab(group, btn)
        end
        return Tab
    end
    return Window
end
return Fluent
